{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**", "/*.(svg|cur|jpg|jpeg|png|webp|gif|ico|woff|woff2|ttf)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-servicios",
      "urls": ["http://localhost:9090/services/**"],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "6h",
        "strategy": "freshness"
      }
    },
    {
      "name": "api-talleres",
      "urls": ["http://localhost:9090/workshops/**"],
      "cacheConfig": {
        "maxSize": 10,
        "maxAge": "12h",
        "strategy": "freshness"
      }
    }
  ]
}